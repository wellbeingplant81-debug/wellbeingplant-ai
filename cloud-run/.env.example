# cloud-run/.env.example
# 이 파일을 복사해 cloud-run/.env로 저장하고 값을 채우세요.
# .env는 로컬 개발용이며 git에는 커밋되지 않습니다(.gitignore 참고).
# Cloud Run에 배포할 때는 이 값들을 서비스 환경변수(또는 Secret
# Manager)로 설정하면 되고, .env 파일은 필요 없습니다 - 두 방식 모두
# app/__init__.py의 load_dotenv()가 지원합니다(이미 설정된 실제
# 환경변수를 .env가 덮어쓰지 않습니다).

# TTS Provider: "google"(기본값) 또는 "elevenlabs"
TTS_PROVIDER=google

# TTS_PROVIDER=elevenlabs일 때만 필요
ELEVENLABS_API_KEY=
# 아래 둘 중 하나만 설정하면 됩니다. ELEVENLABS_VOICE_NAME이 있으면
# 우선 사용되고, 없으면 ELEVENLABS_VOICE_ID를 사용합니다.
ELEVENLABS_VOICE_ID=
ELEVENLABS_VOICE_NAME=

# 스톡 asset provider (선택) - 둘 다 없거나 검색 결과가 없으면
# AI Image 생성으로 자동 폴백합니다.
PEXELS_API_KEY=
PIXABAY_API_KEY=

# Sprint38 - Hybrid Asset Engine 모드: "low_cost" | "balanced"(기본값)
# | "premium". scene 중요도(인물/의료 vs 풍경/생활)에 따라 AI Image와
# Pexels/Pixabay를 섞어 쓰되, 이 값으로 AI 사용 상한과 Pexels 품질
# 허용 기준을 함께 조정합니다. low_cost는 비용을, premium은 품질을
# 우선합니다.
ASSET_MODE=balanced

# Gemini(script 생성) / Imagen(AI Image) / Google TTS는 이 앱 코드가
# 아니라 Google SDK가 Application Default Credentials로 인증합니다.
# 로컬에서는 `gcloud auth application-default login`을 실행하거나,
# 서비스 계정 키 파일 경로를 아래에 지정하세요.
# GOOGLE_APPLICATION_CREDENTIALS=

# ─────────────────────────────────────────────────────────────────────
# Sprint217 (Epic 61) - SNS 계정 연동
#
# 화면 오른쪽 [SNS 계정]이 세 플랫폼의 상태를 그립니다. 아래 값이
# 없으면 그 플랫폼은 "설정 필요"로 표시되고 로그인 단추가 잠깁니다 -
# 눌러도 안 되는 단추를 내놓지 않기 때문입니다.
# ─────────────────────────────────────────────────────────────────────

# YouTube - 환경변수가 아니라 **파일**로 설정합니다.
#
# Google Cloud Console > API 및 서비스 > 사용자 인증 정보에서
# "OAuth 클라이언트 ID"를 만들 때 유형을 반드시 **데스크톱 앱**으로
# 고르고, 내려받은 JSON을 아래 자리에 두십시오.
#
#   개발 중        cloud-run/credentials/client_secret.json
#   묶은 프로그램  %APPDATA%\AI영상제작소\credentials\client_secret.json
#
# 데스크톱 앱 클라이언트는 loopback(http://localhost:임의포트)으로
# 콜백을 받으므로 redirect URI를 따로 등록할 필요가 없습니다.
# 필요한 Scope는 youtube.readonly와 youtube.upload 둘입니다.
#
# 자리를 직접 정하려면 이 둘을 쓰십시오(있으면 위 기본 자리를 이깁니다).
# YOUTUBE_OAUTH_CLIENT_SECRET_PATH=
# YOUTUBE_OAUTH_TOKEN_STORE_PATH=

# Instagram - Meta 개발자 콘솔에서 앱을 만들고 Instagram Business
# Login을 켠 뒤 App ID / App Secret을 여기 적으십시오. Redirect URI는
# 정확히 일치해야 하므로(동적 포트 불가) 아래 값과 같은 것을 Meta에
# 등록해야 합니다.
#
# 주의 - Meta는 프로덕션에서 HTTPS redirect를 요구합니다. 로컬 HTTP
# 만으로는 끝나지 않을 수 있고, 그때는 HTTPS 터널(ngrok 등)을 앞에
# 두어야 합니다. 그 부분은 코드가 대신 해결하지 않습니다.
INSTAGRAM_OAUTH_CLIENT_ID=
INSTAGRAM_OAUTH_CLIENT_SECRET=
# INSTAGRAM_OAUTH_REDIRECT_URI=http://localhost:8551/callback

# TikTok - TikTok for Developers에서 앱을 만들고 Login Kit을 켠 뒤
# Client key / Client secret을 여기 적으십시오. 아래 Redirect URI를
# 그 앱에 등록해야 합니다. 데스크톱에서는 PKCE(S256)가 필수이고,
# 그것은 코드가 요청마다 알아서 만듭니다.
#
# 지금 요청하는 Scope는 user.info.basic 하나입니다(계정 연결까지).
# 실제 영상 업로드까지 가려면 video.publish가 더 필요하고 그것은
# TikTok의 심사를 받아야 합니다.
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
# TIKTOK_OAUTH_REDIRECT_URI=http://127.0.0.1:8562/callback

# 저장된 로그인은 Windows DPAPI로 감싸 둡니다(사용자 계정에 묶임).
# 토큰 파일을 다른 계정/다른 PC로 옮겨야 할 때만 1로 두십시오 -
# 그러면 평문으로 저장되고 화면이 그 사실을 경고합니다.
# AI_STUDIO_TOKEN_PLAINTEXT=
